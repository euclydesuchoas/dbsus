<Project>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Compiler warnings and quality analyzers (CA rules) fail the build. Code style (IDE rules)
    stays at the severities in .editorconfig and is not enforced on build. NuGet audit warnings
    are reported but do not fail the build.
  -->
  <PropertyGroup Label="Analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The key pair is committed on purpose, following Microsoft's guidance for open-source
    libraries. It must never change: doing so changes the assembly identity.
  -->
  <PropertyGroup Label="Strong naming">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)DbSus.snk</AssemblyOriginatorKeyFile>
    <DbSusPublicKey></DbSusPublicKey>
  </PropertyGroup>

  <!--
    Versions are set by hand while publishing is manual. During 0.x the AssemblyVersion carries
    Major.Minor (0.1.0.0, 0.2.0.0, ...) because every 0.x minor may break; from 1.0 onwards it
    carries the major only (1.0.0.0, 2.0.0.0, ...).
  -->
  <PropertyGroup Label="Versioning">
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <AssemblyVersion>$([System.Version]::Parse($(VersionPrefix)).ToString(2)).0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Authors>Euclydes Uchoas</Authors>
    <Copyright>Copyright (c) 2026 Euclydes Uchoas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/euclydesuchoas/dbsus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/euclydesuchoas/dbsus.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Label="Package files" Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <!-- Drawn by tools/icon/make-icon.cs. -->
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!-- Only packages that contain third-party code (DbSus: the blast.c port) set IncludeThirdPartyNotices. -->
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false"
          Condition="'$(IncludeThirdPartyNotices)' == 'true'" />
  </ItemGroup>

</Project>
