<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
    <RootNamespace>DbSus</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>DbSus</PackageId>
    <IncludeThirdPartyNotices>true</IncludeThirdPartyNotices>
    <PackageTags>datasus;sus;dbc;dbf;dbase;datareader;ado.net;brazil;brasil;health;saude</PackageTags>
    <Description>Fully managed reader for the .dbc (compressed dBase) and .dbf files distributed by DATASUS: DBC decompression, streaming DBF reading and a DbDataReader. Independent project, not affiliated with the Brazilian Ministry of Health or DATASUS.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

  <!-- .NET Framework: Span<T> needs System.Memory; code pages are built in. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PartNaming.cs" Link="Shared\PartNaming.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbSus.Tests" Key="$(DbSusPublicKey)" />
  </ItemGroup>

  <!--
    Every change to the public API shows up in PublicAPI.Unshipped.txt (see docs/decisions.md).
    RS0026 (several overloads with optional parameters) applies only to APIs not in
    PublicAPI.Shipped.txt; until the first release moves the baseline there, it would flag the
    existing overload sets, which are deliberate. Remove the suppression when that happens.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
