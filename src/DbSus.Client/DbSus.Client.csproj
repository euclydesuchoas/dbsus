<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
    <RootNamespace>DbSus.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>DbSus.Client</PackageId>
    <PackageTags>datasus;sus;dbc;dbf;dbase;ftp;download;brazil;brasil;health;saude</PackageTags>
    <Description>Downloads DATASUS files from its public FTP server and opens them with DbSus: listing, split-table discovery, resumable downloads with retries, and an optional local cache. Independent project, not affiliated with the Brazilian Ministry of Health or DATASUS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbSus\DbSus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PartNaming.cs" Link="Shared\PartNaming.cs" />
    <Compile Include="..\DbSus\Guard.cs" Link="Shared\Guard.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbSus.Client.Tests" Key="$(DbSusPublicKey)" />
    <InternalsVisibleTo Include="DbSus.Client.LockHelper" Key="$(DbSusPublicKey)" />
  </ItemGroup>

  <!--
    Every change to the public API shows up in PublicAPI.Unshipped.txt (see docs/decisions.md).
    RS0026 (several overloads with optional parameters) applies only to APIs not in
    PublicAPI.Shipped.txt; until the first release moves the baseline there, it would flag the
    existing overload sets, which are deliberate. Remove the suppression when that happens.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
