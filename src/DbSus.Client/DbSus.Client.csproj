<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
    <RootNamespace>DbSus.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>DbSus.Client</PackageId>
    <PackageTags>datasus;sus;dbc;dbf;dbase;ftp;download;brazil;brasil;health;saude</PackageTags>
    <Description>Downloads DATASUS files from its public FTP server and opens them with DbSus: listing, split-table discovery, resumable downloads with retries, and an optional local cache. It has a catalog of 112 DATASUS file types, to find, list and open tables by dataset, state and period. Independent project, not affiliated with the Brazilian Ministry of Health or DATASUS.</Description>
    <PackageReleaseNotes>FTP client for the DATASUS server (listing, downloads with cache, retries). It has a catalog of 112 DATASUS file types, to find, list and open tables by dataset, state and period. The changes in each version are in CHANGELOG.md: https://github.com/euclydesuchoas/dbsus/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbSus\DbSus.csproj" />
  </ItemGroup>

  <!--
    A project reference is packed as "DbSus >= this version", with no upper bound. During 0.x a
    minor version may break the API, so the client declares DbSus from its own version up to the
    next minor (the next major from 1.0 on). The bound ends in "-a" so that the previews of the
    next line are left out too: 0.2.0-preview.1 sorts below 0.2.0, and every release label that
    starts with a letter (alpha, preview.1, rc.1) sorts at or above "a". It is not "-0", which
    sorts lower still: nuget.org refuses a version whose release label is a single identifier
    that does not start with a letter, and rejected DbSus.Client 0.1.0-preview.3 for its
    "0.2.0-0". The target rewrites an item of the NuGet pack targets
    (_ProjectReferencesWithVersions), which is not a public extension point; a step of the
    "Package consumers" job in ci.yml checks the range in the packed nuspec.
  -->
  <PropertyGroup>
    <DbSusDependencyUpperBound Condition="'$([System.Version]::Parse($(VersionPrefix)).Major)' == '0'">0.$([MSBuild]::Add($([System.Version]::Parse($(VersionPrefix)).Minor), 1)).0-a</DbSusDependencyUpperBound>
    <DbSusDependencyUpperBound Condition="'$([System.Version]::Parse($(VersionPrefix)).Major)' != '0'">$([MSBuild]::Add($([System.Version]::Parse($(VersionPrefix)).Major), 1)).0.0-a</DbSusDependencyUpperBound>
  </PropertyGroup>

  <Target Name="DeclareDbSusDependencyRange" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'DbSus'">
        <ProjectVersion>[$(PackageVersion), $(DbSusDependencyUpperBound))</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\Shared\PartNaming.cs" Link="Shared\PartNaming.cs" />
    <Compile Include="..\DbSus\Guard.cs" Link="Shared\Guard.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbSus.Client.Tests" Key="$(DbSusPublicKey)" />
    <InternalsVisibleTo Include="DbSus.Client.LockHelper" Key="$(DbSusPublicKey)" />
  </ItemGroup>

  <!-- Every change to the public API shows up in PublicAPI.Unshipped.txt (see docs/decisions.md). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
