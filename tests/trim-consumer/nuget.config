<?xml version="1.0" encoding="utf-8"?>
<!-- Restores DbSus from the package just built (dotnet pack -o artifacts/packages), into a private
     folder so a re-packed version with the same number is never served from a cache. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/trim-consumer-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="DbSus" />
      <package pattern="DbSus.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
