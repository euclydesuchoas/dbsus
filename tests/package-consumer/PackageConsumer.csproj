<Project Sdk="Microsoft.NET.Sdk">

  <!-- Smoke test of the packed NuGet packages, one target per asset:
       net8.0 -> netstandard2.0, net10.0 -> net10.0, net481 -> net472. Not part of DbSus.slnx.
       Shared settings and package references are in Directory.Build.props. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(TargetFrameworks);net481</TargetFrameworks>
    <DefaultItemExcludes>$(DefaultItemExcludes);sdk8/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
