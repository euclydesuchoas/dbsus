<!--
  Stops the repository's build settings (signing, analyzers) from applying: these projects play an
  outside consumer. Shared by PackageConsumer.csproj and sdk8/PackageConsumer.Sdk8.csproj.
-->
<Project>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DbSusVersion Condition="'$(DbSusVersion)' == ''">0.1.0-preview.1</DbSusVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DbSus" Version="[$(DbSusVersion)]" />
    <PackageReference Include="DbSus.Client" Version="[$(DbSusVersion)]" />
  </ItemGroup>

  <!--
    -p:PinOldestDependencies=true plays an application that already references the oldest versions
    the packages accept (the minimums in src/Directory.Packages.props). If a minimum is raised, this
    restore fails with a downgrade error (NU1605), as it would for such an application.
  -->
  <ItemGroup Condition="'$(PinOldestDependencies)' == 'true' and '$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="System.Memory" Version="4.5.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="4.4.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="1.0.0" />
  </ItemGroup>

  <!--
    In this mode the references above are deliberate, so NU1510 (a reference to a package that is
    part of the framework, e.g. System.Memory on net8.0, "will not be pruned") is expected noise.
    Seen only on the Ubuntu runner; why Windows did not report it was not investigated.
  -->
  <PropertyGroup Condition="'$(PinOldestDependencies)' == 'true'">
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

</Project>
