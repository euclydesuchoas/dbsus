<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Polyfills for the netstandard2.0 build (and System.Memory for net472); in-box on net10.0.
    These are the versions tests and benchmarks use; the libraries declare lower minimums in
    src/Directory.Packages.props. The same applies to Microsoft.Bcl.AsyncInterfaces below.
  -->
  <ItemGroup Label="Polyfills">
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.12" />
  </ItemGroup>

  <!--
    FluentFTP: a minimum, without an upper bound (NuGet's guidance for third-party dependencies with
    no known incompatibility). The weekly "FluentFTP latest" workflow sets an exact version from
    the command line (-p:FluentFtpVersion=[x.y.z]) to test the newest release.
  -->
  <PropertyGroup>
    <FluentFtpVersion Condition="'$(FluentFtpVersion)' == ''">55.0.0</FluentFtpVersion>
  </PropertyGroup>

  <ItemGroup Label="Client">
    <PackageVersion Include="FluentFTP" Version="$(FluentFtpVersion)" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
  </ItemGroup>

  <!-- Tracks the libraries' public API in PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt. -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- System.Text.Json is in-box on net10.0; the net481 test target needs the package. -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
